# ── RT-NIDS Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in production values.

# API key for REST endpoint authentication (leave empty to disable)
API_KEY=

# Configuration overrides
IDS_CONFIG_PATH=config.yaml
IDS_LOG_LEVEL=INFO
IDS_DB_PATH=data/incidents.db

# Server
IDS_HOST=0.0.0.0
IDS_PORT=5000
